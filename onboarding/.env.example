# Copy this file to infra/onboarding/.env and fill in values.
#
# This layer assumes infra/matrix has already been applied. By default
# infra/onboarding/infra.sh sources ../matrix/.env first, then this file.
#
# Product-level Matrix behavior that onboarding depends on, such as the welcome-room
# auto-join policy and the explicit Matrix admin account, is owned by infra/matrix.

########################################
# No Required Onboarding-Specific Secrets
########################################

# infra/onboarding/infra.sh generates and persists the internal onboarding bot Matrix password on
# the target host under:
#   $MATRIX_DATA_ROOT/secrets/onboarding/onboarding-bot-matrix-password
# The Matrix admin credentials come from MATRIX_ADMIN_* in matrix/.env (or equivalent env file).

# Path on the target host where infra/onboarding/infra.sh keeps the VM's dedicated Codex auth.json.
# When bootstrap needs the auth-proxy scenario, apply installs Codex on the VM with npm if needed,
# runs `codex login --device-auth` there when this file is missing, then uses that remote auth.
# The default path is /srv/matrix/onboarding-codex/.codex/auth.json.
# ONBOARDING_CODEX_AUTH_JSON_PATH=/srv/matrix/onboarding-codex/.codex/auth.json

########################################
# Optional: Existing Responses Service
########################################

# If amber-manager already has a shared responses bindable service, set its bindable service ID
# and you can omit the auth-proxy flow entirely.
# ONBOARDING_SHARED_RESPONSES_BINDABLE_SERVICE_ID=bsvc_123

# Or point onboarding at a shared responses bindable service by display name. The default is
# `responses-api`, which also matches the onboarding auth-proxy export when that scenario is used.
# ONBOARDING_SHARED_RESPONSES_BINDABLE_SERVICE_NAME=responses-api

########################################
# Optional: Usernames
########################################

# ONBOARDING_BOOTSTRAP_OPERATOR_USERNAME=$MATRIX_ADMIN_USERNAME
# ONBOARDING_BOOTSTRAP_ONBOARDING_BOT_USERNAME=onboarding
# ONBOARDING_BOOTSTRAP_WELCOME_ROOM_ALIAS_LOCALPART=welcome

########################################
# Optional: Models
########################################

# ONBOARDING_ONBOARDING_MODEL=gpt-5.4-mini
# ONBOARDING_ONBOARDING_MODEL_REASONING_EFFORT=medium
# ONBOARDING_DEFAULT_AGENT_MODEL=gpt-5.4-mini
# ONBOARDING_DEFAULT_AGENT_MODEL_REASONING_EFFORT=medium

########################################
# Optional: Source URLs
########################################

# Default child-agent manifest source. Remote HTTP(S) URLs are passed through directly.
# Local file paths are staged into amber-manager on apply.
# ONBOARDING_DEFAULT_AGENT_SOURCE_URL=https://raw.githubusercontent.com/ricelines/scenarios/refs/heads/main/amber/user-agent.json5

# Auth-proxy source. Remote HTTP(S) URLs are passed through directly.
# Local file paths are staged into amber-manager on apply.
# ONBOARDING_AUTH_PROXY_SOURCE_URL=https://raw.githubusercontent.com/ricelines/codex-a2a/refs/heads/main/amber/codex-auth-proxy.json5

########################################
# Optional: Local Overrides
########################################

# By default these point at this checkout's onboarding manifests and prompt sources.
# Override only when you intentionally want a different local source.
# ONBOARDING_PROVISIONER_MANIFEST_PATH=../../onboarding/amber/agent-provisioner.json5
# ONBOARDING_ONBOARDING_MANIFEST_PATH=../../onboarding/amber/onboarding-agent.json5
# ONBOARDING_ONBOARDING_DEVELOPER_INSTRUCTIONS_PATH=../../onboarding/prompts/onboarding-developer-instructions.md
# ONBOARDING_ONBOARDING_WORKSPACE_AGENTS_MD_PATH=/absolute/path/to/workspace-agents.md
# ONBOARDING_DEFAULT_AGENT_DEVELOPER_INSTRUCTIONS_PATH=../../onboarding/prompts/default-user-agent-developer-instructions.md
# ONBOARDING_DEFAULT_AGENT_AGENTS_MD_PATH=../../onboarding/agents/default-user-agent.md
# ONBOARDING_DEFAULT_AGENT_WORKSPACE_AGENTS_MD_PATH=/absolute/path/to/workspace-agents.md

########################################
# Optional: Local Runtime
########################################

# Local TCP port used for the SSH tunnel into amber-manager's loopback API.
# ONBOARDING_MANAGER_TUNNEL_PORT=54100

# Optional local Codex config TOML override. If unset, infra/onboarding writes a minimal
# config with child_agents_md enabled into a temporary file for bootstrap.
# ONBOARDING_CODEX_CONFIG_TOML_PATH=/absolute/path/to/config.toml

# Destroy is guarded. Set this to the Matrix server_name from infra/matrix/.env before
# running `infra/onboarding/infra.sh destroy`.
# ONBOARDING_DESTROY_CONFIRM=example.net

# Optional: also delete onboarding-created child agent scenarios during destroy.
# Default is false, which makes destroy refuse if such scenarios exist.
# ONBOARDING_DESTROY_INCLUDE_USER_AGENTS=false

########################################
# Optional: Alternate Base Matrix Config
########################################

# Override only if you do not want to inherit infra/matrix/.env automatically.
# ONBOARDING_MATRIX_ENV_FILE=/absolute/path/to/matrix.env
